# Database for Vercel Functions + Neon
DATABASE_URL=postgresql://user:***@host/db?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:***@host-unpooled/db?sslmode=require
POSTGRES_URL=postgresql://user:***@host/db?sslmode=require
POSTGRES_URL_NON_POOLING=postgresql://user:***@host-unpooled/db?sslmode=require

# Sincronización remota de turnos (DESACTIVADA por defecto, local-first).
# La app guarda todo en localStorage. Solo actívala si despliegas el backend
# /api/shifts de forma privada; hoy no hay auth ni aislamiento por usuario.
# VITE_ENABLE_REMOTE_STORAGE=true

# Fallback VLM server-side para ingesta de PDF/imagen degradados
# (POST /api/ingestion/vlm). El provider por defecto es 'openai-compatible'
# (endpoint estilo /v1/chat/completions); 'fake' es solo para dev/test/QA.
# VLM_PROVIDER=openai-compatible
# VLM_API_KEY=
# URL completa del endpoint chat/completions (incluye la ruta):
# VLM_API_URL=https://provider.example.com/v1/chat/completions
# VLM_MODEL=
# VLM_TIMEOUT_MS=30000
# VLM_MAX_FILE_MB=4
# VLM_MAX_PAGES=3
# SOLO dev/test (con VLM_PROVIDER=fake):
#   success | partial | malformed | timeout | rate-limited | provider-error
# VLM_FAKE_BEHAVIOR=success
# VLM_FAKE_DELAY_MS=0
# Además, SOLO con VLM_PROVIDER=fake, el endpoint acepta por petición los
# headers `x-vlm-fake-behavior` / `x-vlm-fake-delay-ms` para sobreescribir
# ambos valores sin reiniciar el servidor (QA visual / E2E). Con un provider
# real estos headers se ignoran por completo.
