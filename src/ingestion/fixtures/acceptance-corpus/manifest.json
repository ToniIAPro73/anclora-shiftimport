{
  "schema_version": "1.0",
  "corpus": "anclora-shiftimport-synthetic",
  "corpus_version": "1.0",
  "product": "Anclora ShiftImport",
  "purpose": "M0 acceptance and regression corpus for format detection, extraction, user selection and robustness.",
  "canonical_test_levels": {
    "L1_FORMAT": "Detect supported/unsupported formats and fail explicitly.",
    "L2_EXTRACTION": "Extract all assignments and compare with golden expected.json.",
    "L3_PRODUCT": "Apply UserProfile and return only the selected worker/team assignments for review."
  },
  "canonical_errors": [
    "UNKNOWN_EMPLOYEE",
    "AMBIGUOUS_EMPLOYEE",
    "EMPTY_DOCUMENT",
    "MALFORMED_INPUT",
    "UNSUPPORTED_FORMAT",
    "NO_SHIFTS_FOUND",
    "UNSUPPORTED_LAYOUT"
  ],
  "suggested_m0_thresholds": {
    "clean_assignment_accuracy_min": 0.99,
    "degraded_assignment_accuracy_min": 0.95,
    "wrong_employee_assignments_tolerated": 0,
    "silent_corruption_tolerated": 0
  },
