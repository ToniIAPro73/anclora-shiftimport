{
  "name": "anclora-shiftimport",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node -e \"const p='../anclora-infrastructure/scripts/free-port.mjs';if(require('fs').existsSync(p)){try{require('child_process').execFileSync(process.execPath,[p],{stdio:'inherit'})}catch(e){process.exit(e.status||1)}}\" && node scripts/qa/dev-runtime.mjs",
    "dev:frontend": "vite",
    "proxy": "node proxy-server.mjs",
    "dev:full": "concurrently \"npm run proxy\" \"npm run dev\"",
    "build": "tsc && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e:install": "npm --prefix qa/e2e-acceptance ci",
    "e2e:install:chromium": "npm --prefix qa/e2e-acceptance exec -- playwright install chromium",
    "e2e:compatibility": "npm --prefix qa/e2e-acceptance exec -- playwright test --config qa/e2e-acceptance/playwright.shift-compatibility.config.ts",
    "e2e:visual": "npm --prefix qa/e2e-acceptance exec -- playwright test --config qa/e2e-acceptance/playwright.shift-compatibility.config.ts --grep \"AA-readable\"",
    "e2e:production": "npm --prefix qa/e2e-acceptance exec -- playwright test --config qa/e2e-acceptance/playwright.shift-compatibility.prod.config.ts",
    "preview": "vite preview",
    "seed:dev": "node --env-file=.env.development.local db/seed-dev.mjs",
    "db:migrate": "node --env-file=.env.local db/migrate.mjs",
    "db:migrate:status": "node --env-file=.env.local db/migrate.mjs --status",
    "qa:dev-runtime": "node scripts/qa/dev-runtime.mjs",
    "qa:current-proposed": "node scripts/qa/current-proposed-e2e.mjs",
    "qa:mixed-import": "node scripts/qa/mixed-import-e2e.mjs",
    "qa:import-reversion": "node scripts/qa/import-reversion-e2e.mjs",
    "qa:local:smoke": "node scripts/qa/qa-smoke.mjs --local",
    "qa:preview:smoke": "node scripts/qa/qa-smoke.mjs --preview",
    "dev:docker": "node scripts/start-local.mjs",
    "qa:mirror:refresh": "node scripts/qa/refresh-qa-mirror.mjs",
    "qa:identity:ensure": "node scripts/qa/ensure-qa-identity.mjs"
  },
  "dependencies": {
    "@anclora/design-system": "github:ToniIAPro73/anclora-design-system#87655c449e3bda41787e82d00aa8a8e17473b616",
    "@neondatabase/serverless": "^1.0.2",
    "axios": "^1.6.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "exceljs": "^4.3.0",
    "express": "^4.18.2",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "lucide-react": "^0.446.0",
    "multer": "^1.4.5-lts.1",
    "pdfjs-dist": "^4.10.38",
    "pg": "^8.23.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.17",
    "@types/multer": "^1.4.7",
    "@types/node": "^20.3.1",
    "@types/react": "^18.3.10",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "@typescript-eslint/parser": "^8.8.0",
    "@vitejs/plugin-react": "^4.3.2",
    "@vitest/coverage-v8": "^4.1.10",
    "concurrently": "^8.2.0",
    "eslint": "^9.11.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.12",
    "jsdom": "^30.0.1",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "vitest": "^4.1.10"
  }
}
